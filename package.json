{
  "name": "code-intel-digest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "npm run playbook:ensure && NODE_OPTIONS=--max-old-space-size=1024 next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "db:start": "docker-compose up -d postgres",
    "db:stop": "docker-compose down",
    "db:sync:from-prod": "npx tsx scripts/sync-production-to-local-postgres.ts",
    "db:sync:to-prod": "npx tsx scripts/sync-local-to-production-postgres.ts",
    "db:mirror": "npx tsx scripts/mirror-from-production.ts",
    "db:mirror:dry-run": "npx tsx scripts/mirror-from-production.ts --dry-run",
    "sync:daily": "npx tsx scripts/run-daily-sync.ts",
    "cron:daily": "NODE_OPTIONS=--max-old-space-size=460 npx tsx scripts/cron-daily-sync.ts",
    "cron:agents": "npm run playbook:ensure && npx tsx scripts/cron-agent-jobs.ts",
    "langsmith:dataset:content-ideas": "npx tsx scripts/langsmith/sync-content-ideas-dataset.ts",
    "langsmith:dataset:market-brief": "npx tsx scripts/langsmith/sync-market-brief-dataset.ts",
    "langsmith:eval:content-ideas": "npx tsx scripts/langsmith/evaluate-content-ideas.ts",
    "langsmith:eval:market-brief": "npx tsx scripts/langsmith/evaluate-market-brief.ts",
    "backfill:fulltext": "npx tsx scripts/archive/backfill-fulltext-production.ts",
    "clear-audio-cache": "bash -lc 'test -n \"${LOCAL_DATABASE_URL:-${DATABASE_URL:-}}\" && psql \"${LOCAL_DATABASE_URL:-$DATABASE_URL}\" -v ON_ERROR_STOP=1 -c \"DELETE FROM \\\"generated_podcast_audio\\\";\" && rm -rf .data/audio/* && echo \"Audio cache cleared\" || (echo \"Set LOCAL_DATABASE_URL or DATABASE_URL\" && exit 1)'",
    "playbook:ensure": "npx tsx scripts/ensure-playbook-state.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@mozilla/readability": "^0.6.0",
    "@types/pdfkit": "^0.17.5",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/react-datepicker": "^6.2.0",
    "dotenv": "^17.2.3",
    "html2pdf.js": "^0.12.1",
    "jsdom": "^27.4.0",
    "langsmith": "^0.5.11",
    "lucide-react": "^0.561.0",
    "marked": "^17.0.3",
    "next": "^16.1.1",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^6.10.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "pg-copy-streams": "^7.0.0",
    "react": "^19.2.3",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.3",
    "tsx": "^4.19.2",
    "uuid": "^13.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.0.15",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "playwright": "^1.57.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.15"
  }
}
